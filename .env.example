# Copy this file to .env and fill in the values. Never commit .env.

# --- Nebius Token Factory (verify base URL in the Nebius console) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Fallback chat model if rate-limited: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
EMBED_DIM=4096
EMBED_BATCH_SIZE=32
MAX_COMPLETION_TOKENS=2048
LLM_TIMEOUT_S=60
EMBED_TIMEOUT_S=30

# --- Local storage ---
QDRANT_URL=http://localhost:6333
DATA_DIR=./data

# --- Ingestion & retrieval ---
CHUNK_MAX_CHARS=3200
CHUNK_OVERLAP_CHARS=480
MAX_UPLOAD_MB=20
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.42
FACT_DEDUP_THRESHOLD=0.9

# --- Agent & sandbox ---
MAX_AGENT_ITERATIONS=6
SANDBOX_IMAGE=assistant-sandbox:latest
SANDBOX_TIMEOUT_S=30
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_MAX_OUTPUT_BYTES=65536
# Linux only: group id of /var/run/docker.sock (stat -c %g /var/run/docker.sock). macOS: 0
DOCKER_GID=0

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# --- Privacy ---
LOG_PROMPTS=false
LANGCHAIN_TRACING_V2=false
