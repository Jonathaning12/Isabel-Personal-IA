# Copy this file to .env and fill in the values. Never commit .env.

# --- Inference provider: nebius (default, required for the hackathon) | gemini (testing only) ---
LLM_PROVIDER=nebius
# For gemini: set GEMINI_API_KEY, LLM_MODEL=gemini-2.5-flash,
# EMBED_MODEL=gemini-embedding-001, EMBED_DIM=3072 (check with scripts/verify_models.py)
GEMINI_API_KEY=

# --- Obsidian vault (optional): host path, mounted at /vault in the API container ---
# Isabel can list/read/search notes freely; every write needs your approval.
OBSIDIAN_VAULT=
OBSIDIAN_VAULT_NAME=
# --- Projects folder (optional): folders + git repos, mounted at /projects ---
PROJECTS_HOST=
PROJECTS_NAME=Documentos
# Your .gitconfig (commit author), mounted read-only
GIT_CONFIG_HOST=
# For git push to GitHub: fine-grained token with Contents read/write
GITHUB_TOKEN=

# Optional live web search when the Gemini key has no Google Search quota (free tier at brave.com/search/api)
BRAVE_API_KEY=

# Natural spoken replies (Gemini only): TTS_MODEL=gemini-3.8-flash-lite-tts, TTS_VOICE=Achernar

# --- Nebius Token Factory (verify base URL in the Nebius console) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Fallback chat model if rate-limited: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
EMBED_DIM=4096
EMBED_BATCH_SIZE=32
MAX_COMPLETION_TOKENS=2048
LLM_TIMEOUT_S=60
EMBED_TIMEOUT_S=30

# --- Local storage ---
QDRANT_URL=http://localhost:6333
DATA_DIR=./data

# --- Ingestion & retrieval ---
CHUNK_MAX_CHARS=3200
CHUNK_OVERLAP_CHARS=480
MAX_UPLOAD_MB=20
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.42
FACT_DEDUP_THRESHOLD=0.9

# --- Agent & sandbox ---
MAX_AGENT_ITERATIONS=6
SANDBOX_IMAGE=assistant-sandbox:latest
SANDBOX_TIMEOUT_S=30
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_MAX_OUTPUT_BYTES=65536
# Linux only: group id of /var/run/docker.sock (stat -c %g /var/run/docker.sock). macOS: 0
DOCKER_GID=0

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# --- Privacy ---
LOG_PROMPTS=false
LANGCHAIN_TRACING_V2=false
