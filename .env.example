# Copy this file to .env and fill in the values. Never commit .env.

# --- Nebius Token Factory (verify base URL in the Nebius console) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Fallback chat model if rate-limited: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
EMBED_DIM=4096
EMBED_BATCH_SIZE=32
MAX_COMPLETION_TOKENS=2048
LLM_TIMEOUT_S=60
EMBED_TIMEOUT_S=30

# --- Local storage ---
QDRANT_URL=http://localhost:6333
DATA_DIR=./data

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Privacy ---
LOG_PROMPTS=false
LANGCHAIN_TRACING_V2=false
